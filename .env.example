# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Google Maps Platform key. When set, TripCircle uses real Places search and
# real travel times; when empty, it runs entirely on the built-in Bay Area
# place list. See docs/providers.md for which APIs to enable and how to lock
# the key down before shipping a build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: your own backend that proxies Google and attaches the key
# server-side. When set, the key above is not needed and never ships in the
# app bundle. Example: https://api.yourdomain.com/gmaps
EXPO_PUBLIC_GOOGLE_PROXY_URL=

# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Google Maps Platform key. When set, TripCircle uses real Places search and
# real travel times; when empty, it runs entirely on the built-in Bay Area
# place list. See docs/providers.md for which APIs to enable and how to lock
# the key down before shipping a build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: your own backend that proxies Google and attaches the key
# server-side. When set, the key above is not needed and never ships in the
# app bundle. Example: https://api.yourdomain.com/gmaps
EXPO_PUBLIC_GOOGLE_PROXY_URL=

# The PIRT Supabase project (shared wishlists). Both values are safe to
# publish: the key grants nothing on its own, because every table is behind
# row-level security and the signed-out role has no grant at all. What
# protects the data is the policy set in supabase/migrations.
#
# Leave these empty and the app runs exactly as it did before the server
# existed — the diary, the planner and day sharing are all local and never
# touch it.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
